#!/usr/bin/env bash
set -euo pipefail

me=$(basename "$0")
file="${1:?usage: $me STATEMENT.csv [min-gap-days] [max-reports]}"
min_gap=${2:-3}
max_report=${3:-5}

[[ -f "$file" ]] || { echo "error: file not found: $file" >&2; exit 1; }

tmp_dates=$(mktemp)
tmp_gaps=$(mktemp)
tmp_lines=$(mktemp)
trap 'rm -f "$tmp_dates" "$tmp_gaps" "$tmp_lines"' EXIT

awk -F',' '{gsub(/\r/, "", $1)} $1 ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/ {cnt[$1]++; n++} END {for (d in cnt) print d, cnt[d]}' "$file" | sort > "$tmp_dates"

[[ -s "$tmp_dates" ]] || { echo "error: no transaction dates found in $file" >&2; exit 1; }

declare -a dates counts g_from g_to g_days g_before g_after
declare -A first_line
g_from=() g_to=() g_days=() g_before=() g_after=()

awk -F',' '{gsub(/\r/, "", $1)} $1 ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/ && !seen[$1] {seen[$1] = 1; print $1, NR}' "$file" > "$tmp_lines"
while read -r d ln; do first_line[$d]=$ln; done < "$tmp_lines"

while read -r d c; do
  dates+=("$d")
  counts+=("$c")
done < "$tmp_dates"

total_txn=0
for c in "${counts[@]}"; do total_txn=$((total_txn + c)); done

max_days=0
big_from=""
big_to=""
for ((i = 1; i < ${#dates[@]}; i++)); do
  prev=${dates[$((i - 1))]}
  cur=${dates[$i]}
  days=$(( ( $(date -d "$cur" +%s) - $(date -d "$prev" +%s) ) / 86400 ))
  if (( days > min_gap )); then
    g_from+=("$prev")
    g_to+=("$cur")
    g_days+=("$days")
    g_before+=("${counts[$((i - 1))]}")
    g_after+=("${counts[$i]}")
    if (( days > max_days )); then
      max_days=$days
      big_from=$prev
      big_to=$cur
    fi
  fi
done

echo "file:  $file"
echo "range: ${dates[0]} .. ${dates[-1]}  (${#dates[@]} distinct days, $total_txn transactions)"
echo "gaps longer than ${min_gap} day(s): ${#g_days[@]}"

if (( ${#g_days[@]} == 0 )); then
  echo "no significant gaps - the statement looks continuous"
  exit 0
fi

for i in "${!g_days[@]}"; do
  printf '%s|%s|%s|%s|%s\n' "${g_days[$i]}" "${g_from[$i]}" "${g_to[$i]}" "${g_before[$i]}" "${g_after[$i]}"
done | sort -t'|' -k1,1rn > "$tmp_gaps"

echo
printf '%-5s %-12s %-12s %6s  %s\n' "" "last txn" "next txn" "days" "txns b/a"
i=0
while IFS='|' read -r days f t b a; do
  i=$((i + 1))
  (( i <= max_report )) || break
  flag=""
  (( i == 1 )) && flag="   <-- largest"
  printf '%-5s %-12s %-12s %6s  %s/%s   line %s%s\n' "" "$f" "$t" "$days" "$b" "$a" "${first_line[$t]:-?}" "$flag"
done < "$tmp_gaps"

echo
echo "rows around the largest gap ($big_from -> $big_to):"
echo "  before gap:"
awk -F',' -v from="$big_from" '{gsub(/\r/, "", $0)} $1 <= from {printf "    %4d: %s\n", NR, $0}' "$file" | tail -3 || true
echo "  after gap:"
awk -F',' -v to="$big_to" '{gsub(/\r/, "", $0)} $1 >= to {printf "    %4d: %s\n", NR, $0}' "$file" | head -3 || true

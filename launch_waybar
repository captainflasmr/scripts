#!/bin/bash

# Start the Waybar configuration named in ~/.config/waybar_active.
# Logs to ~/.cache/waybar-launch.log so startup failures are diagnosable.
# Usage: launch_waybar

CONFIG_FILE="$HOME/.config/waybar_active"
LOG_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/waybar-launch.log"
mkdir -p "$(dirname "$LOG_FILE")"

if [[ ! -f $CONFIG_FILE ]]; then
    echo "$HOME/.config/waybar" > "$CONFIG_FILE"
fi

DIR=$(cat "$CONFIG_FILE")
CSS="$DIR/style.css"

log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG_FILE"; }

if [[ ! -f $DIR/config || ! -f $CSS ]]; then
    log "ERROR: missing config or style under $DIR"
    exit 1
fi

start_waybar() {
    log "starting waybar with $DIR"
    killall waybar 2>/dev/null

    # Wait for any previous instance to actually disappear before starting.
    for _ in {1..10}; do
        pgrep -x waybar >/dev/null || break
        sleep 0.2
    done

    # setsid detaches Waybar from this script/session so it survives after
    # launch_waybar exits (Sway starts this from its startup script).
    setsid waybar -c "$DIR/config" -s "$CSS" >> "$LOG_FILE" 2>&1 &
    local pid=$!
    sleep 1

    if kill -0 "$pid" 2>/dev/null; then
        log "waybar running (pid $pid)"
        return 0
    fi

    log "waybar exited during startup"
    return 1
}

for attempt in 1 2 3; do
    start_waybar && exit 0
    log "waybar attempt $attempt failed; retrying"
    sleep 1
done

log "ERROR: waybar failed to start after 3 attempts"
exit 1
